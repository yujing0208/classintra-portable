; ClassIntra 项目 .npmrc 配置（开源仓库版）
; 优先使用预编译包（避免 better-sqlite3 等原生模块在本机工具链缺失时编译失败）
; 当预编译包不可用时自动回退到源码编译
build_from_source=false

; ---- 国内镜像加速（便携包附加，开源仓库默认保留，国内用户更友好）----
; 统一走国内镜像，避免直连 npmjs/GitHub 超时
registry=https://registry.npmmirror.com

; better-sqlite3 prebuilt 二进制改从 npmmirror 镜像下载
better_sqlite3_binary_host_mirror=https://registry.npmmirror.com/-/binary/better-sqlite3

; pnpm 10 的 node_modules 整体重建会要求交互确认，非交互环境直接失败；
; 关闭该安全提示
confirmModulesPurge=false

; 提示：便携包（绿色版）场景会把 pnpm store 放到包内 runtime/pnpm-store，
; 保证自包含、零系统污染。做法：在本文件追加一行
;   store-dir=../../runtime/pnpm-store
; 普通源码开发/部署无需该行，使用 pnpm 默认 store 即可。
